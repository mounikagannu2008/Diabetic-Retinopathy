# ============================================================
# Dataset & derived data — large, and should never be committed.
# Anyone cloning this repo needs to download APTOS themselves
# (see DATA_SETUP.md) and regenerate splits/cache locally.
# ============================================================
data/
!data/.gitkeep

# ============================================================
# Trained models — large binary files, don't belong in git.
# Checkpoints are regenerated by running train.py.
# ============================================================
models/
!models/.gitkeep

# ============================================================
# Generated outputs — evaluation reports, plots, cached predictions.
# All regenerated by running evaluate.py / inference.py.
# ============================================================
outputs/
!outputs/.gitkeep

# ============================================================
# Unused leftover from the original Kaggle download — no labels,
# not used anywhere in this pipeline (see project notes).
# ============================================================
test_images/

# ============================================================
# Python environment
# ============================================================
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ============================================================
# IDE / OS clutter
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Jupyter (in case notebooks get added later)
# ============================================================
.ipynb_checkpoints/

# ============================================================
# Streamlit local config/secrets (if ever added)
# ============================================================
.streamlit/secrets.toml
